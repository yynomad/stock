# Copy to stock.conf. Actual stock.conf is ignored by Git.
# Export the referenced secrets in the process environment; no implicit .env loading.
[service]
data_dir = runtime
timezone = Asia/Shanghai
log_level = INFO

[database]
url_env = STOCKMAN_DATABASE_URL

[broker]
provider = snaptrade
account_env = SNAPTRADE_ACCOUNT_ID
client_id_env = SNAPTRADE_CLIENT_ID
consumer_key_env = SNAPTRADE_CONSUMER_KEY
sync_interval_seconds = 900

# For explicit Gemini, change [model] to [model.gemini] and add:
# base_url = https://generativelanguage.googleapis.com
# To use DeepSeek instead, replace the active model block with:
# [model.deepseek]
# base_url = https://api.deepseek.com
# api_key_env = DEEPSEEK_API_KEY
# name = deepseek-flash
# Optional official Gemini grounding key when using a gateway or DeepSeek:
# grounding_api_key_env = STOCKMAN_GROUNDING_API_KEY
[model]
name = gemini-3.5-flash-lite
api_key_env = GEMINI_API_KEY
max_calls = 8
max_tools = 12
context_bytes = 49152
# Same-session history and symbol carryover, in seconds.
context_ttl_seconds = 86400
max_research_queries = 3
research_timeout_seconds = 90
# Optional soft threshold per interactive task (USD); omit to disable.
# task_budget_usd = 0.05
# USD per million tokens, only for the named model. Verify your provider prices.
# price_model = gemini-3.5-flash-lite
# input_rate = 0.30
# output_rate = 2.50

[notification]
provider = telegram
token_env = TG_BOT_TOKEN
chat_id_env = TG_CHAT_ID
allowed_users_env = TG_ALLOWED_USERS
interactive = true

[briefing]
# Optional operator alert sent to the configured private Telegram chat.
alerts_enabled = false
# Starts automatically on schedule when YOU launch the configured service.
enabled = true
time = 08:00
daily_budget_usd = 0.20
max_calls = 8
max_research_queries = 3
max_report_model_calls = 4
research_timeout_seconds = 90
max_output_tokens = 2048
max_events = 5
lookback_hours = 24
retention_days = 30
# For DeepSeek, set price_model to the research model and replace both token rates.
# price_model = deepseek-flash
input_rate = 0.30
output_rate = 2.50

[monitor]
interval_seconds = 300
buffer_pct = 0.02
max_daily_alerts = 5
quote_max_age_seconds = 900

[sources]
file = briefing.sources.json
sec_user_agent_env = SEC_USER_AGENT
