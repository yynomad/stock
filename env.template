# ╔══════════════════════════════════════════════════════════════╗
# ║         盘前补仓计算器 · 环境变量配置文件                      ║
# ║         复制本文件为 .env，填入真实值后保存                     ║
# ╚══════════════════════════════════════════════════════════════╝
#
# ⚠️  安全提示：
#     · 本文件包含敏感凭证，务必加入 .gitignore，禁止上传至任何代码仓库
#     · 建议将本文件权限设置为仅当前用户可读（Windows：属性→安全）

# ──────────────────────────────────────────────────────────────
# IB Gateway / TWS 连接配置
# ──────────────────────────────────────────────────────────────

# IB Gateway 运行的主机地址（本地部署保持 127.0.0.1 即可）
IB_HOST=127.0.0.1

# 端口号说明（只填其中一个）：
#   · TWS 实盘账户    → 7496
#   · TWS 模拟账户    → 7497  ← 推荐开发测试使用
#   · IB Gateway 实盘 → 4001
#   · IB Gateway 模拟 → 4002
IB_PORT=7497

# Client ID：每个同时连接的客户端需使用不同的 ID（1~999 均可）
# 若有其他程序也在连接 IB，请修改此值以避免冲突
IB_CLIENT_ID=10

# ──────────────────────────────────────────────────────────────
# Telegram Bot 推送配置
# ──────────────────────────────────────────────────────────────

# 从 @BotFather 获取的 Bot Token
# 示例格式：123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_BOT_TOKEN=your_telegram_bot_token_here

# 接收消息的 Chat ID（个人账户或群组）
# 获取方式：与 @userinfobot 对话，或访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 后查看 chat.id
# 个人 Chat ID 为正整数；群组 Chat ID 为负整数，如 -1001234567890
TG_CHAT_ID=your_chat_id_here
