# ╔══════════════════════════════════════════════════════════════╗
# ║         盘前 PA 策略计算器 · 环境变量配置文件            ║
# ║         复制本文件为 .env，填入真实值后保存                     ║
# ╚══════════════════════════════════════════════════════════════╝
#
# ⚠️  安全提示：
#     · 本文件包含敏感凭证，务必加入 .gitignore，禁止上传至任何代码仓库

# ──────────────────────────────────────────────────────────────
# Telegram Bot 推送配置（可选）
# ──────────────────────────────────────────────────────────────
# 留空则跳过推送，仅在控制台输出报告。

# 从 @BotFather 获取的 Bot Token
TG_BOT_TOKEN=

# 接收消息的 Chat ID
TG_CHAT_ID=

# ──────────────────────────────────────────────────────────────
# Yahoo Finance 网络配置（可选）
# ──────────────────────────────────────────────────────────────

# 国内网络访问 Yahoo Finance 较慢/不稳定时配置 HTTP 代理
# 例：http://127.0.0.1:7890
YF_PROXY=

# 标的之间请求间隔（秒），避免触发 Yahoo 限流。默认 5
YF_REQUEST_DELAY=5

# ──────────────────────────────────────────────────────────────
# Gemini Vision 持仓截图识别（可选）
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ──────────────────────────────────────────────────────────────
# 仓位决策梯度（可选）
# ──────────────────────────────────────────────────────────────
# 数值为比例：0.10 = 10%
POSITION_PROBE_ADD_PCT=0.05
POSITION_NORMAL_ADD_PCT=0.10
POSITION_STRONG_ADD_PCT=0.20
POSITION_TAKE_PROFIT_PCT=0.20
POSITION_STRONG_TAKE_PROFIT_PCT=0.35
POSITION_RISK_REDUCE_PCT=0.25

# ──────────────────────────────────────────────────────────────
# 实时价格监控参数（可选，默认值适合大多数人）
# ──────────────────────────────────────────────────────────────
# 轮询间隔（分钟）。价格在支撑/阻力之间正常波动时不会打扰您。
# MONITOR_INTERVAL=5

# 突破确认缓冲比例（百分比的小数形式）。0.02 = 2%
# 价格必须超出关键位 2% 才视为真突破，过滤盘中毛刺。
# MONITOR_BUFFER_PCT=0.02

# 每个标的每日最多提醒次数，防止震荡市刷屏。
# MONITOR_MAX_DAILY_ALERTS=5
