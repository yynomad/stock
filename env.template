# ╔══════════════════════════════════════════════════════════════╗
# ║         盘前 PA 策略计算器 v3.0 · 环境变量配置文件            ║
# ║         复制本文件为 .env，填入真实值后保存                     ║
# ╚══════════════════════════════════════════════════════════════╝
#
# ⚠️  安全提示：
#     · 本文件包含敏感凭证，务必加入 .gitignore，禁止上传至任何代码仓库

# ──────────────────────────────────────────────────────────────
# Telegram Bot 推送配置
# ──────────────────────────────────────────────────────────────

# 从 @BotFather 获取的 Bot Token
TG_BOT_TOKEN=your_telegram_bot_token_here

# 接收消息的 Chat ID
TG_CHAT_ID=your_chat_id_here

# ──────────────────────────────────────────────────────────────
# IBKR Flex Query 持仓获取（主方案）
# ──────────────────────────────────────────────────────────────
# 配置方法：IBKR Account Management → Flex Queries → 创建 Position 查询
# 不占用 API 会话，不影响手机登录

# Flex Web Service Token
IBKR_FLEX_TOKEN=

# Position Query ID
IBKR_FLEX_QUERY_ID=

# ──────────────────────────────────────────────────────────────
# 大模型读图持仓识别（降级方案）
# ──────────────────────────────────────────────────────────────
# 当 Flex Query 不可用时，发送持仓截图给 Vision API 识别
# 支持火山引擎/OpenAI 兼容的 Vision API

# Vision API 地址（火山引擎默认）
VISION_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# Vision API Key
VISION_API_KEY=

# Vision 模型 ID（火山引擎视觉模型）
VISION_MODEL=doubao-1-5-vision-pro-32k

# 持仓截图路径（手动放入或由外部程序自动保存）
POSITION_IMAGE_PATH=positions.jpg
