# ╔══════════════════════════════════════════════════════════════╗
# ║         盘前 PA 策略计算器 v3.0 · 环境变量配置文件            ║
# ║         复制本文件为 .env，填入真实值后保存                     ║
# ╚══════════════════════════════════════════════════════════════╝
#
# ⚠️  安全提示：
#     · 本文件包含敏感凭证，务必加入 .gitignore，禁止上传至任何代码仓库

# ──────────────────────────────────────────────────────────────
# Telegram Bot 推送配置（可选）
# ──────────────────────────────────────────────────────────────
# 留空则跳过推送，仅在控制台输出报告。

# 从 @BotFather 获取的 Bot Token
TG_BOT_TOKEN=

# 接收消息的 Chat ID
TG_CHAT_ID=

# ──────────────────────────────────────────────────────────────
# Yahoo Finance 网络配置（可选）
# ──────────────────────────────────────────────────────────────

# 国内网络访问 Yahoo Finance 较慢/不稳定时配置 HTTP 代理
# 例：http://127.0.0.1:7890
YF_PROXY=

# 标的之间请求间隔（秒），避免触发 Yahoo 限流。默认 5
YF_REQUEST_DELAY=5
